# Chuẩn hoá line ending cho môi trường Linux/WSL.
* text=auto eol=lf
*.sh text eol=lf
*.py text eol=lf
*.mk text eol=lf
*.md text eol=lf
*.ps1 text eol=crlf
Makefile text eol=lf

# File nhị phân không xử lý text.
*.pdf binary
*.png binary
*.jpg binary
*.img binary

# Raw week-1 logs keep shell prompts and tool output byte-for-byte.
# Ignore trailing whitespace in evidence logs only, not source files.
results/week01/**/*.log -whitespace
