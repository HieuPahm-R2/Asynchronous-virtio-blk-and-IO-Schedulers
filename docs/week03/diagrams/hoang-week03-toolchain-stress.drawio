        <mxCell id="13" value="4c. Khôi phục Production&#10;make clean &amp;&amp; make kernel/kernel fs.img&#10;${TOOLPREFIX}nm kiểm 0 hook symbol" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E9F0FF;strokeColor=#315EAB;fontColor=#18283F;fontFamily=Arial;fontSize=17;spacing=10;" vertex="1" parent="1">
