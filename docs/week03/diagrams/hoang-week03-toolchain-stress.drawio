  <diagram id="hoang-w3-1" name="02 W3-H02 Stress READ 4 Producer">
    <mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="840" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="W3-H02 | Kiến trúc Stress READ 4 tiến trình producer thực có kiểm dữ liệu 1024 B" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=26;fontColor=#18283F;fontStyle=1;" vertex="1" parent="1">
