        </mxCell>
        <mxCell id="4" value="user/init.c (PID 1)&#10;io_selftest(-1): Chuẩn bị 8 khối&#10;blockno 700..707 (1024B/khối)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E9F0FF;strokeColor=#315EAB;fontColor=#18283F;fontFamily=Arial;fontSize=16;spacing=10;fontStyle=1;" vertex="1" parent="1">
