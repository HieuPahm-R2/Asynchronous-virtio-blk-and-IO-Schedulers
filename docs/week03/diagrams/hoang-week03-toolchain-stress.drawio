        </mxCell>
        <mxCell id="8" value="Nếu thiếu" style="edgeStyle=none;html=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#B84C5B;fontFamily=Arial;fontSize=16;fontColor=#18283F;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1">
