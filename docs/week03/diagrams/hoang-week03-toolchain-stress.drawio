  <diagram id="hoang-w3-0" name="01 W3-H01 Toolchain va Xac minh Main">
    <mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="840" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="PTO-21 / W3-H01 | Đồng bộ TOOLPREFIX/NM và xác minh nhánh main sau merge" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=26;fontColor=#18283F;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="45" y="20" width="1400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="3" value="Nguyễn Văn Hoàng (20233413) | Kiểm tra công cụ trước khi tạo thư mục log; hỗ trợ riscv64-unknown-elf- và riscv64-linux-gnu-" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontColor=#18283F;" vertex="1" parent="1">
          <mxGeometry x="45" y="62" width="1400" height="32" as="geometry" />
        </mxCell>
        <mxCell id="4" value="1. Phân giải TOOLPREFIX&#10;--toolprefix | env TOOLPREFIX |&#10;make -s print-toolprefix" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E9F0FF;strokeColor=#315EAB;fontColor=#18283F;fontFamily=Arial;fontSize=18;spacing=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="135" width="380" height="110" as="geometry" />
        </mxCell>
        <mxCell id="5" value="2. Pre-flight check công cụ&#10;make, qemu-system-riscv64,&#10;${NM}, gcc, objdump, ld + elf64-big" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E9F0FF;strokeColor=#315EAB;fontColor=#18283F;fontFamily=Arial;fontSize=18;spacing=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="520" y="135" width="420" height="110" as="geometry" />
        </mxCell>
        <mxCell id="6" value="Thiếu binary / sai target:&#10;Báo lỗi stderr + exit(2)&#10;KHÔNG tạo thư mục results/" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FBEAEC;strokeColor=#B84C5B;fontColor=#18283F;fontFamily=Arial;fontSize=18;spacing=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1030" y="135" width="410" height="110" as="geometry" />
        </mxCell>
        <mxCell id="7" value="NM=$(TOOLPREFIX)nm" style="edgeStyle=none;html=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#315EAB;fontFamily=Arial;fontSize=16;fontColor=#18283F;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
