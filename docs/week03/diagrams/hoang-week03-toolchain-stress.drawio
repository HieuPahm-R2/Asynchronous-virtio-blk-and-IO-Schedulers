        <mxCell id="12" value="4b. Đối chứng âm + Mock suites&#10;negative-corrupt-fixture → EXPECTED_FAIL&#10;pool-cpus1/4 + queue-cpus1/4 → 4/4 PASS" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFF2DE;strokeColor=#BC7A24;fontColor=#18283F;fontFamily=Arial;fontSize=17;spacing=10;" vertex="1" parent="1">
