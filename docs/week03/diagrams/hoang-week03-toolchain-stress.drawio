        <mxCell id="3" value="Nguyễn Văn Hoàng (20233413) | Cờ biên dịch riêng -DIO_STRESS_SELFTEST; không chạm 4 tệp lõi runtime" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontColor=#18283F;" vertex="1" parent="1">
