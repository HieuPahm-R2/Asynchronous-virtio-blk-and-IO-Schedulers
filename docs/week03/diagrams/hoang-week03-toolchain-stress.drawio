            <mxPoint x="1030" y="190" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="9" value="3. Tạo thư mục kết quả&#10;results/week03/hoang-ubuntu/...&#10;Ghi nhận meta.json + versions" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E7F4EF;strokeColor=#26775A;fontColor=#18283F;fontFamily=Arial;fontSize=18;spacing=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="520" y="310" width="420" height="105" as="geometry" />
